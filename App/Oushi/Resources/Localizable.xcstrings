        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kohteen suosikkitilaa ei voi juuri nyt muuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier le statut de favori de cet élément pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile modificare lo stato di preferito di questo elemento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は現在お気に入りを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 항목의 즐겨찾기 상태를 변경할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu šio elemento negalima pažymėti kaip mėgstamo ar pašalinti iš mėgstamų."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De favorietstatus van dit onderdeel kan nu niet worden gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz dodać tego elementu do ulubionych ani usunąć go z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível favoritar ou desfavoritar este item agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нельзя добавить этот объект в избранное или удалить его оттуда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปลี่ยนสถานะรายการโปรดของรายการนี้ได้ในขณะนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğenin favori durumu şu anda değiştirilemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не можна додати цей об’єкт до вибраного або вилучити його звідти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể thay đổi trạng thái yêu thích của mục này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目暫時無法更改個人收藏狀態。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個項目暫時無法變更喜好項目狀態。"
          }
        }
      }
    },
    "这台设备限制了对照片的访问。": {
      "comment": "Access card text, parental restrictions.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Fotos ist auf diesem Gerät eingeschränkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is restricted on this device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is restricted on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a las fotos está restringido en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvien käyttöä on rajoitettu tällä laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux photos est restreint sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alle foto è limitato su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは写真へのアクセスが制限されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 사진 접근이 제한되어 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame įrenginyje prieiga prie nuotraukų apribota."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot foto’s is op dit apparaat beperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do zdjęć na tym urządzeniu jest ograniczony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso às fotos está restrito neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к фото на этом устройстве ограничен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงรูปภาพถูกจำกัดบนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta fotoğraflara erişim kısıtlanmış."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до фото на цьому пристрої обмежено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập ảnh bị giới hạn trên thiết bị này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置限制了相片的存取權限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置限制了照片的取用權限。"
          }
        }
      }
    },
    "这将清除所有浏览记录。已查看的照片和视频会重新出现，待删除的内容会保留。": {
      "comment": "Message of that alert.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der gesamte Verlauf gelöscht. Bereits gesehene Fotos und Videos erscheinen erneut. Die Löschliste bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears all review history. Photos and videos you’ve seen will come up again, and the deletion queue is kept."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears all review history. Photos and videos you’ve seen will come up again, and the deletion queue is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrará todo el historial de visualización. Las fotos y los vídeos ya vistos volverán a aparecer. Lo marcado para eliminar se conserva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tyhjentää koko selaushistorian. Jo katsotut kuvat ja videot tulevat uudelleen vastaan. Poistolista säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout l’historique de visionnage sera effacé. Les photos et vidéos déjà vues réapparaîtront. Les éléments à supprimer sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà cancellata tutta la cronologia di visione. Le foto e i video già visti ricompariranno. Gli elementi da eliminare vengono mantenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての閲覧記録が消去されます。表示済みの写真とビデオが再び表示されます。削除待ちの項目はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 보기 기록이 지워집니다. 이미 본 사진과 비디오가 다시 나타나며, 삭제 대기 항목은 유지됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus išvalyta visa peržiūros istorija. Jau peržiūrėtos nuotraukos ir vaizdo įrašai pasirodys vėl. Ištrynimo eilė išsaugoma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de hele geschiedenis gewist. Foto’s en video’s die je al hebt gezien, komen opnieuw voorbij. De verwijderlijst blijft behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie całej historii przeglądania. Obejrzane zdjęcia i wideo pojawią się ponownie. Elementy oznaczone do usunięcia zostaną zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o histórico de visualização será apagado. As fotos e os vídeos já vistos aparecerão de novo. Os itens marcados para apagar são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся история просмотра будет очищена. Просмотренные фото и видео появятся снова. Объекты, отмеченные к удалению, сохранятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะล้างประวัติการดูทั้งหมด รูปภาพและวิดีโอที่ดูแล้วจะปรากฏขึ้นอีก ส่วนรายการที่รอลบจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem tüm görüntüleme kayıtlarını siler. Görülen fotoğraflar ve videolar yeniden karşınıza çıkar. Silinecekler korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усю історію переглядів буде очищено. Переглянуті фото й відео з’являться знову. Об’єкти, позначені до видалення, збережуться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa toàn bộ lịch sử xem. Ảnh và video đã xem sẽ xuất hiện lại, mục chờ xóa vẫn được giữ nguyên."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這將清除所有瀏覽記錄。已查看的相片和影片會重新出現，待刪除的內容會保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將清除所有瀏覽紀錄。已查看的照片和影片會重新出現，待刪除的內容會保留。"
          }
        }
      }
    },
