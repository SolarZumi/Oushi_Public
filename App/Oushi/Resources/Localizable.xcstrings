    "左右滑动保留，下滑移入待删除": {
      "comment": "Accessibility hint on a photo card.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Seite streichen, um zu behalten; nach unten, um zum Löschen vorzumerken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe sideways to keep, down to queue for deletion"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe sideways to keep, down to queue for deletion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a los lados para conservar o hacia abajo para marcar para eliminar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise sivulle säilyttääksesi, alas lisätäksesi poistolistalle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez sur le côté pour conserver, vers le bas pour mettre en attente de suppression"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri di lato per tenere, verso il basso per segnare da eliminare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にスワイプで残す、下にスワイプで削除待ちに追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆으로 쓸어넘기면 보관, 아래로 쓸어넘기면 삭제 대기에 추가"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Braukite į šoną, kad paliktumėte, arba žemyn, kad įtrauktumėte į ištrynimo eilę"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg opzij om te bewaren, omlaag om op de verwijderlijst te zetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w bok, aby zachować, lub w dół, aby oznaczyć do usunięcia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para os lados para manter ou para baixo para marcar para apagar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните в сторону, чтобы оставить, или вниз, чтобы отметить к удалению"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดไปด้านข้างเพื่อเก็บไว้ ปัดลงเพื่อย้ายไปที่รายการที่รอลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklamak için yana, silineceklere eklemek için aşağı kaydırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посуньте вбік, щоб залишити, або вниз, щоб позначити до видалення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang bên để giữ, vuốt xuống để đưa vào mục chờ xóa"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "左右滑動以保留，向下滑動以加至待刪除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右滑動以保留，向下滑動以加入待刪除"
          }
        }
      }
    },
